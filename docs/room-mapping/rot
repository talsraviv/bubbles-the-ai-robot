#!/usr/bin/env bash
# Rotate in place with K-turn pairs. No camera involved at all — the sonar and
# motors are healthy even when the CSI link isn't.
# Usage: rot PAIRS DIR SECS   (DIR = l|r)
set -euo pipefail
HOST="${PICARX_HOST:-bubbles@bubbles.local}"
PAIRS="${1:-2}"; DIR="${2:-l}"; SECS="${3:-0.5}"

ssh "$HOST" "PAIRS=$PAIRS DIR=$DIR SECS=$SECS python3 - <<'PY'
import os, time, statistics
from picarx import Picarx

pairs = max(1, min(8, int(os.environ['PAIRS'])))
sgn   = 1 if os.environ['DIR'].lower().startswith('r') else -1
secs  = max(0.1, min(1.2, float(os.environ['SECS'])))
STEER, SPEED = 28, 30

def rng(px, samples=15):
    vals = []
    for _ in range(samples):
        d = px.get_distance()
        if d and 2 < d < 400: vals.append(d)
        time.sleep(0.035)
    return round(statistics.median(vals), 1) if vals else None

def arc(px, speed, steer, secs):
    px.set_dir_servo_angle(steer); time.sleep(0.25)
    (px.forward if speed > 0 else px.backward)(abs(speed))
    time.sleep(secs)
    px.stop(); px.set_dir_servo_angle(0); time.sleep(0.5)

px = Picarx()
try:
    px.set_cam_pan_angle(0); px.set_cam_tilt_angle(0)
    time.sleep(0.4)
    print(f'range_before={rng(px)}', flush=True)
    for i in range(pairs):
        arc(px,  SPEED,  sgn * STEER, secs)     # forward arc first: we start at a wall
        arc(px, -SPEED, -sgn * STEER, secs)
        time.sleep(0.4)
        print(f'pair {i+1}/{pairs} range={rng(px)}', flush=True)
finally:
    px.stop(); px.set_dir_servo_angle(0)
PY"
