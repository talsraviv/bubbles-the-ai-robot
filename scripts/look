#!/usr/bin/env bash
# Point the camera. Usage: look PAN TILT
#   PAN  -90..90 (positive = right), TILT -35..65 (positive = up)
# Note: the aim holds until the next Picarx() instantiation (e.g. any `drive`).
set -euo pipefail
HOST="${PICARX_HOST:-bubbles@bubbles.local}"
PAN="${1:?usage: look PAN TILT}"
TILT="${2:?usage: look PAN TILT}"

[[ "$PAN" =~ ^-?[0-9]+$ && "$TILT" =~ ^-?[0-9]+$ ]] || { echo "PAN and TILT must be integers" >&2; exit 1; }

ssh "$HOST" "PAN=$PAN TILT=$TILT python3 - <<'PY'
import os, time
from picarx import Picarx

pan  = max(-90, min(90, int(os.environ['PAN'])))
tilt = max(-35, min(65, int(os.environ['TILT'])))

px = Picarx()
px.set_cam_pan_angle(pan)
px.set_cam_tilt_angle(tilt)
time.sleep(0.3)   # let the servos settle before a snap
print(f'camera: pan={pan} tilt={tilt}')
PY"
