#!/usr/bin/env bash
# Robot health check: reachability, camera, battery, uptime.
set -euo pipefail
HOST="${PICARX_HOST:-bubbles@bubbles.local}"

ssh -o ConnectTimeout=5 "$HOST" bash -s <<'REMOTE'
echo "host: $(hostname) up $(uptime -p | sed 's/^up //')"
CAM=$(rpicam-hello --list-cameras 2>&1 | grep -c '^[0-9] :' || true)
echo "camera: $([ "$CAM" -ge 1 ] && echo present || echo NOT DETECTED)"
MIC=$(arecord -l 2>/dev/null | grep -c '^card [0-9]*:.*USB' || true)
echo "microphone: $([ "$MIC" -ge 1 ] && echo present || echo "NOT FOUND (voice mode unavailable — use text chat)")"
python3 - <<'PY' 2>/dev/null || echo "battery: n/a"
try:
    from robot_hat import utils
    v = utils.get_battery_voltage()
    print(f"battery: {v:.2f} V" + ("  (LOW — charge soon)" if v < 6.8 else ""))
except Exception:
    print("battery: n/a")
PY
REMOTE
